Algoritmo MostrarNumeros
    Dimension numeros[5]
    Dimension posicion[5]
    
    numeros[0] <- 10
    numeros[1] <- 8
    numeros[2] <- 9
    numeros[3] <- 7
    numeros[4] <- 6
    
    posicion[0] <- 0
    posicion[1] <- 1
    posicion[2] <- 2
    posicion[3] <- 3
    posicion[4] <- 4
    
    Para i <- 0 Hasta 4 Con Paso 1 Hacer
        Escribir "Posicion: ", posicion[i], " Numero: ", numeros[i]
    FinPara
FinAlgoritmo
